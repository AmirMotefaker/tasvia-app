generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MERCHANT
}

enum WorkspaceRole {
  OWNER
  ADMIN
  FINANCE
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  SHIFT_PAYMENT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum AccountingAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

enum AccountingJournalStatus {
  DRAFT
  POSTED
  REVERSED
}

model User {
  id            String       @id @default(uuid())
  name          String?
  email         String?      @unique
  emailVerified Boolean      @default(false)
  image         String?
  phone         String?      @unique
  role          Role         @default(MERCHANT)
  merchant      Merchant?
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model Account {
  id                    String   @id @default(uuid())
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@index([userId])
  @@unique([issuer, accountId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model Workspace {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  memberships        Membership[]
  accountingAccounts AccountingAccount[]
  fiscalPeriods      FiscalPeriod[]
  accountingJournals AccountingJournal[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Membership {
  id          String           @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole    @default(VIEWER)
  status      MembershipStatus @default(ACTIVE)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@unique([userId, workspaceId])
  @@index([workspaceId, status])
  @@index([userId, status])
}

model Merchant {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id])
  name         String
  iban         String?
  status       String        @default("PENDING")
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Transaction {
  id           String            @id @default(uuid())
  merchantId   String
  merchant     Merchant          @relation(fields: [merchantId], references: [id])
  amount       Int
  type         TransactionType
  status       TransactionStatus @default(PENDING)
  trackingCode String?
  orderRef     String?
  targetIban   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  @@index([merchantId])
}

model AccountingAccount {
  id          String                @id @default(uuid())
  workspaceId String
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code        String
  name        String
  type        AccountingAccountType
  parentId    String?
  parent      AccountingAccount?    @relation("AccountingAccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    AccountingAccount[]   @relation("AccountingAccountTree")
  active      Boolean               @default(true)
  journalLines AccountingJournalLine[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId, type, active])
  @@index([parentId])
}

model FiscalPeriod {
  id          String             @id @default(uuid())
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  startsAt    DateTime
  endsAt      DateTime
  status      FiscalPeriodStatus @default(OPEN)
  journals    AccountingJournal[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, startsAt, endsAt])
  @@index([workspaceId, status])
}

model AccountingJournal {
  id               String                  @id @default(uuid())
  workspaceId      String
  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fiscalPeriodId   String?
  fiscalPeriod     FiscalPeriod?           @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  number           String?
  occurredAt       DateTime
  description      String
  status           AccountingJournalStatus @default(DRAFT)
  sourceDocumentId String?
  reversalOfId     String?
  reversalOf       AccountingJournal?      @relation("AccountingJournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals        AccountingJournal[]     @relation("AccountingJournalReversal")
  idempotencyKey   String?
  postedAt         DateTime?
  reversedAt       DateTime?
  lines            AccountingJournalLine[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([workspaceId, number])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, occurredAt])
  @@index([workspaceId, status])
  @@index([sourceDocumentId])
  @@index([fiscalPeriodId])
}

model AccountingJournalLine {
  id          String            @id @default(uuid())
  journalId   String
  journal     AccountingJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId   String
  account     AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit       BigInt            @default(0)
  credit      BigInt            @default(0)
  description String?
  createdAt   DateTime          @default(now())

  @@index([journalId])
  @@index([accountId])
}
