generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MERCHANT
}

enum WorkspaceRole {
  OWNER
  ADMIN
  FINANCE
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  SHIFT_PAYMENT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum AccountingAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

enum AccountingJournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum CounterpartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum OpenBalanceType {
  RECEIVABLE
  PAYABLE
}

enum OpenBalanceStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

enum CatalogItemType {
  STOCK_ITEM
  SERVICE
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PurchaseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  PAID
  CANCELLED
}

enum RecoveryChannel {
  PHONE
  EMAIL
}

model User {
  id                 String                    @id @default(uuid())
  name               String?
  email              String?                   @unique
  emailVerified      Boolean                   @default(false)
  image              String?
  phone              String?                   @unique
  legacyPassword     String?                   @map("password")
  role               Role                      @default(MERCHANT)
  merchant           Merchant?
  sessions           Session[]
  accounts           Account[]
  memberships        Membership[]
  recoveryChallenges LegacyRecoveryChallenge[]
  recoveryGrants     LegacyRecoveryGrant[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String   @id @default(uuid())
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@unique([issuer, accountId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model LegacyRecoveryChallenge {
  id              String          @id
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel         RecoveryChannel
  destinationHint String
  expiresAt       DateTime
  verifiedAt      DateTime?
  createdAt       DateTime        @default(now())

  @@index([userId, expiresAt])
}

model LegacyRecoveryGrant {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuedAt   DateTime
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt, consumedAt])
}

model Workspace {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  memberships        Membership[]
  accountingAccounts AccountingAccount[]
  fiscalPeriods      FiscalPeriod[]
  accountingJournals AccountingJournal[]
  counterparties     Counterparty[]
  openBalances       OpenBalance[]
  catalogItems       CatalogItem[]
  warehouses         Warehouse[]
  stockMovements     StockMovement[]
  purchaseInvoices   PurchaseInvoice[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Membership {
  id          String           @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole    @default(VIEWER)
  status      MembershipStatus @default(ACTIVE)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId, status])
  @@index([userId, status])
}

model Merchant {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id])
  name         String
  iban         String?
  status       String        @default("PENDING")
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Transaction {
  id           String            @id @default(uuid())
  merchantId   String
  merchant     Merchant          @relation(fields: [merchantId], references: [id])
  amount       Int
  type         TransactionType
  status       TransactionStatus @default(PENDING)
  trackingCode String?
  orderRef     String?
  targetIban   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([merchantId])
}

model Counterparty {
  id            String           @id @default(uuid())
  workspaceId   String
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type          CounterpartyType
  name          String
  nationalId    String?
  economicCode  String?
  phone         String?
  email         String?
  active        Boolean          @default(true)
  openBalances      OpenBalance[]
  purchaseInvoices  PurchaseInvoice[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([workspaceId, type, active])
  @@index([workspaceId, name])
}

model OpenBalance {
  id                String            @id @default(uuid())
  workspaceId       String
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  counterpartyId    String
  counterparty      Counterparty      @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  type              OpenBalanceType
  sourceDocumentId  String
  issuedAt          DateTime
  dueAt             DateTime
  originalAmount    BigInt
  outstandingAmount BigInt
  currency          String            @default("IRR")
  status            OpenBalanceStatus @default(OPEN)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([workspaceId, type, sourceDocumentId])
  @@index([workspaceId, type, status, dueAt])
  @@index([counterpartyId, status])
}

model AccountingAccount {
  id           String                  @id @default(uuid())
  workspaceId  String
  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code         String
  name         String
  type         AccountingAccountType
  parentId     String?
  parent       AccountingAccount?      @relation("AccountingAccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     AccountingAccount[]     @relation("AccountingAccountTree")
  active       Boolean                 @default(true)
  journalLines AccountingJournalLine[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId, type, active])
  @@index([parentId])
}

model FiscalPeriod {
  id          String             @id @default(uuid())
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  startsAt    DateTime
  endsAt      DateTime
  status      FiscalPeriodStatus @default(OPEN)
  journals    AccountingJournal[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, startsAt, endsAt])
  @@index([workspaceId, status])
}

model AccountingJournal {
  id               String                  @id @default(uuid())
  workspaceId      String
  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fiscalPeriodId   String?
  fiscalPeriod     FiscalPeriod?           @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  number           String?
  occurredAt       DateTime
  description      String
  status           AccountingJournalStatus @default(DRAFT)
  sourceDocumentId String?
  reversalOfId     String?
  reversalOf       AccountingJournal?      @relation("AccountingJournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals        AccountingJournal[]     @relation("AccountingJournalReversal")
  idempotencyKey   String?
  postedAt         DateTime?
  reversedAt       DateTime?
  lines            AccountingJournalLine[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([workspaceId, number])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, occurredAt])
  @@index([workspaceId, status])
  @@index([sourceDocumentId])
  @@index([fiscalPeriodId])
}

model AccountingJournalLine {
  id          String            @id @default(uuid())
  journalId   String
  journal     AccountingJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId   String
  account     AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit       BigInt            @default(0)
  credit      BigInt            @default(0)
  description String?
  createdAt   DateTime          @default(now())

  @@index([journalId])
  @@index([accountId])
}

model CatalogItem {
  id                   String          @id @default(uuid())
  workspaceId          String
  workspace            Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type                 CatalogItemType
  name                 String
  sku                  String?
  barcode              String?
  unit                 String
  taxRateBasisPoints   Int?
  lowStockThreshold    BigInt?
  active               Boolean         @default(true)
  movements            StockMovement[]
  purchaseLines        PurchaseInvoiceLine[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([workspaceId, sku])
  @@index([workspaceId, type, active])
  @@index([workspaceId, name])
}

model Warehouse {
  id          String          @id @default(uuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  code        String
  active      Boolean         @default(true)
  movements        StockMovement[]
  purchaseInvoices PurchaseInvoice[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId, active])
}

model StockMovement {
  id                 String            @id
  workspaceId        String
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  warehouseId        String
  warehouse          Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  itemId             String
  item               CatalogItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  type               StockMovementType
  quantityMinorUnits BigInt
  occurredAt         DateTime
  reference          String?
  unitCost           BigInt?
  currency           String            @default("IRR")
  createdAt          DateTime          @default(now())

  @@index([workspaceId, occurredAt])
  @@index([warehouseId, itemId, occurredAt])
  @@index([workspaceId, reference])
}

model PurchaseInvoice {
  id               String          @id @default(uuid())
  workspaceId      String
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplierId       String
  supplier         Counterparty    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId      String
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  invoiceNumber    String
  status           PurchaseStatus  @default(DRAFT)
  issuedAt         DateTime
  dueAt            DateTime
  subtotal         BigInt
  discount         BigInt          @default(0)
  tax              BigInt          @default(0)
  total            BigInt
  currency         String          @default("IRR")
  createdBy        String
  submittedAt      DateTime?
  submittedBy      String?
  approvedAt       DateTime?
  approvedBy       String?
  postedAt         DateTime?
  postedBy         String?
  cancelledAt      DateTime?
  cancelledBy      String?
  postedJournalId  String?
  payableId        String?
  lines            PurchaseInvoiceLine[]
  statusHistory    PurchaseStatusHistory[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId, status, issuedAt])
  @@index([supplierId, status, dueAt])
  @@index([warehouseId, issuedAt])
}

model PurchaseInvoiceLine {
  id                 String          @id @default(uuid())
  purchaseInvoiceId  String
  purchaseInvoice    PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  itemId             String
  item               CatalogItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantityMinorUnits BigInt
  unitPrice           BigInt
  discount            BigInt         @default(0)
  tax                 BigInt         @default(0)
  lineTotal           BigInt
  createdAt           DateTime       @default(now())

  @@index([purchaseInvoiceId])
  @@index([itemId])
}

model PurchaseStatusHistory {
  id                String          @id @default(uuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  fromStatus        PurchaseStatus?
  toStatus          PurchaseStatus
  changedBy         String
  changedAt         DateTime        @default(now())
  note              String?

  @@index([purchaseInvoiceId, changedAt])
}
